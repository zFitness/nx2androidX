#!/bin/sh
# nx2androidX ARM64 Linux AppImage entry.
#
# The launcher is PySide6 (Qt), and the PySide6 wheels travel INSIDE this package
# (usr/pylibs): the machine's own python3 runs it, and the machine needs no Qt,
# no GTK and no pip.  The package is read-only (mounted, or unpacked to /tmp/.mount_* with
# APPIMAGE_EXTRACT_AND_RUN=1 on a machine without FUSE), so the player's data —
# the library, the settings, the imported profiles — stays in their own folders.
#
# Fonts: a machine may have none at all (a bare proot, for instance), and then the
# interface shows random glyphs instead of Chinese.  The package carries one Chinese
# font and one monospace face, and a fontconfig configuration is written at run time
# that points at them; the machine's own fonts stay in use as well.
#
# This script uses nothing but shell builtins: on a minimal system even readlink,
# dirname and cat may be broken links.  The only external program is the Python
# it ends up exec'ing.
HERE="${APPDIR:-${0%/*}}"
case "$HERE" in
    "$0") HERE=. ;;
esac
case "$HERE" in
    /*) ;;
    *) HERE="$PWD/$HERE" ;;
esac

PYTHON=/usr/bin/python3
if [ ! -x "$PYTHON" ]; then
    PYTHON=$(command -v python3 2>/dev/null)
fi
if [ -z "$PYTHON" ] || [ ! -x "$PYTHON" ]; then
    printf '%s\n' 'nx2androidX: no python3 on this machine'
    exit 1
fi

# The package's own code: launcher/ and porter/ sit in usr/, and the pipeline is
# started as a child process with this same environment.
export PYTHONPATH="$HERE/usr/pylibs:$HERE/usr${PYTHONPATH:+:$PYTHONPATH}"

# The build toolchain (--with-toolchain packages): the phone payload's clang and glslc,
# a Debian glibc prefix beside them, the .NET runtime and the prebuilt C# tools. On a
# machine with its own compiler every directory here is simply not used.
export NX2A_TOOLCHAIN="$HERE/usr/toolchain"
export DOTNET_ROOT="$HERE/usr/dotnet"
export NX2A_NX_EXTRACT="$HERE/usr/cs-tools/nx_extract"
export NX2A_DMSH_XLATE="$HERE/usr/cs-tools/dmsh_xlate"
# the Python modules' shared libraries (liblz4, libyaml, libcapstone, ...): the ABI
# extensions find them only through the loader path
export LD_LIBRARY_PATH="$HERE/usr/pylibs${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PATH="$HERE/usr/toolchain/clang/bin:$HERE/usr/toolchain/bin:$HERE/usr/dotnet:$PATH"

FONTS="$HERE/usr/share/fonts"
if [ -d "$FONTS" ]; then
    TMP="${TMPDIR:-/tmp}"
    CONF="$TMP/nx2androidX-fonts-$$.conf"
    if [ -f /etc/fonts/fonts.conf ]; then
        INCLUDE='  <include ignore_missing="yes">/etc/fonts/fonts.conf</include>'
    else
        INCLUDE=''
    fi
    {
        printf '%s\n' '<?xml version="1.0"?>'
        printf '%s\n' '<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">'
        printf '%s\n' '<fontconfig>'
        if [ -n "$INCLUDE" ]; then
            printf '%s\n' "$INCLUDE"
        fi
        printf '%s\n' "  <dir>$FONTS</dir>"
        printf '%s\n' "  <cachedir>$TMP/nx2androidX-fontcache-$$</cachedir>"
        printf '%s\n' '</fontconfig>'
    } > "$CONF" 2>/dev/null && export FONTCONFIG_FILE="$CONF"
fi

cd "$HERE/usr" || exit 1
exec "$PYTHON" -m launcher "$@"
